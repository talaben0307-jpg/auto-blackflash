local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer

if CoreGui:FindFirstChild("JJS_Skill3WithTarget") then
    CoreGui.JJS_Skill3WithTarget:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "JJS_Skill3WithTarget"
ScreenGui.Parent = CoreGui
ScreenGui.ResetOnSpawn = false

-- Khung chứa 2 nút bấm cạnh nhau
local Container = Instance.new("Frame")
Container.Parent = ScreenGui
Container.BackgroundTransparency = 1
Container.Position = UDim2.new(0, 50, 0, 200)
Container.Size = UDim2.new(0, 310, 0, 42)
Container.Draggable = true

-- Nút thực hiện Skill 3
local ActionButton = Instance.new("TextButton")
ActionButton.Parent = Container
ActionButton.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
ActionButton.Position = UDim2.new(0, 0, 0, 0)
ActionButton.Size = UDim2.new(0, 190, 0, 42)
ActionButton.Font = Enum.Font.GothamBold
ActionButton.Text = "⚡ Skill 3 (Phím E)"
ActionButton.TextColor3 = Color3.fromRGB(255, 255, 255)
ActionButton.TextSize = 13

local UICorner1 = Instance.new("UICorner")
UICorner1.CornerRadius = UDim.new(0, 8)
UICorner1.Parent = ActionButton

-- Nút Tag / Highlight đối thủ
local TargetButton = Instance.new("TextButton")
TargetButton.Parent = Container
TargetButton.BackgroundColor3 = Color3.fromRGB(45, 35, 35)
TargetButton.Position = UDim2.new(0, 200, 0, 0)
TargetButton.Size = UDim2.new(0, 110, 0, 42)
TargetButton.Font = Enum.Font.GothamBold
TargetButton.Text = "🎯 Tag: OFF"
TargetButton.TextColor3 = Color3.fromRGB(255, 100, 100)
TargetButton.TextSize = 12

local UICorner2 = Instance.new("UICorner")
UICorner2.CornerRadius = UDim.new(0, 8)
UICorner2.Parent = TargetButton

local isExecuting = false
local lockedTarget = nil
local currentHighlight = nil

local function getClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = math.huge
    local localChar = LocalPlayer.Character
    
    if not localChar or not localChar:FindFirstChild("HumanoidRootPart") then return nil end
    local myRootPos = localChar.HumanoidRootPart.Position

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
            if hrp and humanoid and humanoid.Health > 0 then
                local distance = (hrp.Position - myRootPos).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    closestPlayer = p
                end
            end
        end
    end
    return closestPlayer
end

local function removeHighlight()
    if currentHighlight then
        currentHighlight:Destroy()
        currentHighlight = nil
    end
end

-- Xử lý bật/tắt Tag Highlight đối thủ
TargetButton.MouseButton1Click:Connect(function()
    if lockedTarget then
        -- Tắt Tag
        removeHighlight()
        lockedTarget = nil
        TargetButton.Text = "🎯 Tag: OFF"
        TargetButton.TextColor3 = Color3.fromRGB(255, 100, 100)
    else
        -- Bật Tag mục tiêu gần nhất
        local target = getClosestPlayer()
        if target and target.Character then
            lockedTarget = target
            TargetButton.Text = "🎯 Tag: ON"
            TargetButton.TextColor3 = Color3.fromRGB(100, 255, 100)
            
            removeHighlight()
            currentHighlight = Instance.new("Highlight")
            currentHighlight.Adornee = target.Character
            currentHighlight.FillColor = Color3.fromRGB(255, 0, 0)
            currentHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            currentHighlight.Parent = target.Character
        else
            TargetButton.Text = "❌ Không có ai!"
            task.wait(1)
            TargetButton.Text = "🎯 Tag: OFF"
        end
    end
end)

local function executeCombo()
    if isExecuting then return end
    
    local localChar = LocalPlayer.Character
    -- Ưu tiên dùng mục tiêu đã Tag, nếu không có thì tự quét mục tiêu gần nhất
    local target = lockedTarget
    if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
        target = getClosestPlayer()
    end
    
    if not localChar or not localChar:FindFirstChild("HumanoidRootPart") then
        ActionButton.Text = "❌ Chưa load nhân vật!"
        task.wait(1)
        ActionButton.Text = "⚡ Skill 3 (Phím E)"
        return
    end
    
    if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
        ActionButton.Text = "❌ Không thấy đối thủ!"
        task.wait(1)
        ActionButton.Text = "⚡ Skill 3 (Phím E)"
        return
    end

    isExecuting = true
    ActionButton.Text = "⚡ Đang tung combo..."
    
    local myHrp = localChar.HumanoidRootPart
    local targetHrp = target.Character.HumanoidRootPart
    
    -- Dịch chuyển ra sau lưng (giữ nguyên hướng nhìn)
    local currentOrientation = myHrp.CFrame - myHrp.Position
    myHrp.CFrame = (targetHrp.CFrame * CFrame.new(0, 0, 3.5)) + currentOrientation.Position
    
    task.wait(0.05)
    
    -- Bấm phím 3 lần 1
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Three, false, game)
    task.wait(0.04)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Three, false, game)
    
    -- Thời gian chờ nhịp (Timing)
    task.wait(0.25)
    
    -- Bấm phím 3 lần 2
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Three, false, game)
    task.wait(0.04)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Three, false, game)

    task.wait(0.2)
    ActionButton.Text = "⚡ Skill 3 (Phím E)"
    isExecuting = false
end

ActionButton.MouseButton1Click:Connect(executeCombo)

UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.E then
        if UserInputService:GetFocusedTextBox() then return end
        executeCombo()
    end
end)
