--[[
    BLZ Hub (Fluent-Style)
    - Phím bật/tắt menu: L
    - Có tích hợp nút Auto Black Flash cho Yuji Skill 3
]]

local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer

local TOGGLE_KEY = Enum.KeyCode.L

-- Dọn dẹp bản chạy trước
local env = (getgenv and getgenv()) or _G
if env.BLZHubCleanup then pcall(env.BLZHubCleanup) end

local parentGui = (gethui and gethui()) or CoreGui
local connections = {}
local function track(c) table.insert(connections, c) return c end

-- Biến trạng thái Auto Black Flash
local autoBFEnabled = false
local bfDelay = 0.35 -- Mốc chuẩn 0.35s cho Yuji Skill 3[cite: 3]

-- Giao diện chuẩn Fluent UI (Dark Theme + Accent Neon)
local Theme = {
    Background = Color3.fromRGB(15, 15, 20),
    Panel = Color3.fromRGB(22, 22, 30),
    Element = Color3.fromRGB(30, 30, 42),
    Hover = Color3.fromRGB(40, 40, 56),
    Off = Color3.fromRGB(52, 52, 72),
    Stroke = Color3.fromRGB(45, 45, 65),
    Accent = Color3.fromRGB(0, 229, 255),
    Good = Color3.fromRGB(70, 220, 120),
    Text = Color3.fromRGB(240, 240, 245),
    SubText = Color3.fromRGB(150, 150, 175),
    Danger = Color3.fromRGB(255, 75, 75),
}

local function create(class, props, children)
    local inst = Instance.new(class)
    if inst:IsA("GuiObject") then inst.BorderSizePixel = 0 end
    local parent
    for k, v in pairs(props or {}) do
        if k == "Parent" then parent = v else inst[k] = v end
    end
    for _, ch in ipairs(children or {}) do ch.Parent = inst end
    inst.Parent = parent
    return inst
end

local function corner(r) return create("UICorner", { CornerRadius = UDim.new(0, r) }) end
local function stroke(color, thickness)
    return create("UIStroke", { Color = color, Thickness = thickness or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

-- Hàm kéo thả (Draggable) cho cả Menu và Nút lơ lửng
local function makeDraggable(handle, target)
    local dragging, moved = false, false
    local startPos, startInput

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            startInput = input.Position
            startPos = target.Position
        end
    end)
    track(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - startInput
            if delta.Magnitude > 5 then moved = true end
            if moved then
                target.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
    return function() return moved end
end

-- Khởi tạo ScreenGui
local MainGui = create("ScreenGui", { Name = "BLZHubMain", ResetOnSpawn = false, Parent = parentGui })
local FloatGui = create("ScreenGui", { Name = "BLZHubFloat", ResetOnSpawn = false, Enabled = false, Parent = parentGui })

-- ================= KHUNG MENU CHÍNH =================
local MainFrame = create("Frame", {
    Parent = MainGui,
    AnchorPoint = Vector2.new(0.5, 0.5),
    Position = UDim2.new(0.5, 0, 0.5, 0),
    Size = UDim2.new(0, 560, 0, 360),
    BackgroundColor3 = Theme.Background,
}, { corner(12), stroke(Theme.Stroke, 1.5) })

-- Thanh tiêu đề (TopBar) dùng để kéo thả menu
local TopBar = create("Frame", {
    Parent = MainFrame,
    Size = UDim2.new(1, 0, 0, 42),
    BackgroundColor3 = Theme.Panel,
}, { corner(12) })
create("Frame", { Parent = TopBar, Position = UDim2.new(0, 0, 1, -10), Size = UDim2.new(1, 0, 0, 10), BackgroundColor3 = Theme.Panel })

create("TextLabel", {
    Parent = TopBar, BackgroundTransparency = 1,
    Position = UDim2.new(0, 16, 0, 0), Size = UDim2.new(1, -100, 1, 0),
    Font = Enum.Font.GothamBold, Text = "⚡ BLZ Hub", TextSize = 14,
    TextColor3 = Theme.Accent, TextXAlignment = Enum.TextXAlignment.Left,
})

makeDraggable(TopBar, MainFrame)

local function topButton(text, xOff, hoverColor, cb)
    local b = create("TextButton", {
        Parent = TopBar, AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, xOff, 0.5, 0), Size = UDim2.new(0, 28, 0, 28),
        BackgroundColor3 = Theme.Element, Font = Enum.Font.GothamBold, Text = text,
        TextSize = 12, TextColor3 = Theme.Text, AutoButtonColor = false,
    }, { corner(6) })
    b.MouseEnter:Connect(function() b.BackgroundColor3 = hoverColor end)
    b.MouseLeave:Connect(function() b.BackgroundColor3 = Theme.Element end)
    b.MouseButton1Click:Connect(cb)
    return b
end

-- ================= NÚT LƠ LỬNG (FLOATING BUTTON) =================
local FloatBtn = create("TextButton", {
    Parent = FloatGui,
    BackgroundColor3 = Theme.Panel,
    Position = UDim2.new(0, 50, 0, 200),
    Size = UDim2.new(0, 54, 0, 54),
    Font = Enum.Font.GothamBold,
    Text = "BLZ",
    TextSize = 12,
    TextColor3 = Theme.Accent,
    AutoButtonColor = false,
}, { corner(27), stroke(Theme.Accent, 2) })

local floatWasDragged = makeDraggable(FloatBtn, FloatBtn)

local function setVisible(state)
    MainFrame.Visible = state
    FloatGui.Enabled = not state
end

topButton("X", -10, Theme.Danger, function()
    if env.BLZHubCleanup then env.BLZHubCleanup() end
end)
topButton("–", -44, Theme.Hover, function() setVisible(false) end)

FloatBtn.MouseButton1Click:Connect(function()
    if floatWasDragged() then return end
    setVisible(true)
end)

-- ================= BỐ CỤC SIDEBAR & CONTENT =================
local Sidebar = create("ScrollingFrame", {
    Parent = MainFrame,
    BackgroundTransparency = 1,
    Position = UDim2.new(0, 12, 0, 54),
    Size = UDim2.new(0, 140, 1, -66),
    CanvasSize = UDim2.new(0, 0, 0, 0),
    AutomaticCanvasSize = Enum.AutomaticSize.Y,
    ScrollBarThickness = 0,
}, {
    create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }),
})

local ContentContainer = create("Frame", {
    Parent = MainFrame,
    BackgroundTransparency = 1,
    Position = UDim2.new(0, 164, 0, 54),
    Size = UDim2.new(1, -176, 1, -66),
    ClipsDescendants = true,
})

local function createTab(name, icon)
    local btn = create("TextButton", {
        Parent = Sidebar,
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = Theme.Element,
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamSemibold,
        Text = (icon and (icon .. " ") or "") .. name,
        TextSize = 13,
        TextColor3 = Theme.SubText,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false,
    }, { corner(6), create("UIPadding", { PaddingLeft = UDim.new(0, 12) }) })

    local page = create("ScrollingFrame", {
        Parent = ContentContainer,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Visible = false,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent,
    }, {
        create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }),
        create("UIPadding", { PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8) }),
    })

    return btn, page
end

-- Tạo các Tab: JJS Combat & Trang chủ
local tab1Btn, tab1Page = createTab("JJS Combat", "⚡")
local tab2Btn, tab2Page = createTab("Trang chủ", "🏠")

local function selectTab(b, p)
    tab1Btn.BackgroundTransparency = 1 tab1Btn.TextColor3 = Theme.SubText tab1Page.Visible = false
    tab2Btn.BackgroundTransparency = 1 tab2Btn.TextColor3 = Theme.SubText tab2Page.Visible = false

    b.BackgroundTransparency = 0.3 b.TextColor3 = Theme.Accent
    p.Visible = true
end

tab1Btn.MouseButton1Click:Connect(function() selectTab(tab1Btn, tab1Page) end)
tab2Btn.MouseButton1Click:Connect(function() selectTab(tab2Btn, tab2Page) end)
selectTab(tab1Btn, tab1Page)

-- ================= TÍNH NĂNG AUTO BLACK FLASH (TAB JJS) =================
local function createToggle(parent, title, callback)
    local f = create("Frame", {
        Parent = parent,
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = Theme.Element,
    }, { corner(8), stroke(Theme.Stroke, 1) })

    create("TextLabel", {
        Parent = f, BackgroundTransparency = 1,
        Position = UDim2.new(0, 14, 0, 0), Size = UDim2.new(1, -70, 1, 0),
        Font = Enum.Font.Gotham, Text = title, TextSize = 13,
        TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
    })

    local pill = create("Frame", {
        Parent = f, AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.new(0, 40, 0, 20),
        BackgroundColor3 = Theme.Off,
    }, { corner(10) })

    local knob = create("Frame", {
        Parent = pill, AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 3, 0.5, 0), Size = UDim2.new(0, 14, 0, 14),
        BackgroundColor3 = Theme.Text,
    }, { corner(7) })

    local hit = create("TextButton", { Parent = f, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "" })

    local state = false
    hit.MouseButton1Click:Connect(function()
        state = not state
        tween(pill, 0.15, { BackgroundColor3 = state and Theme.Good or Theme.Off })
        tween(knob, 0.15, { Position = state and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) })
        callback(state)
    end)
end

-- Thêm Toggle Auto Black Flash vào Tab JJS Combat
createToggle(tab1Page, "Auto Black Flash (Skill 3)", function(state)
    autoBFEnabled = state
end)

-- Lắng nghe bấm phím 3 để tự động thực hiện timing nhịp thứ 2
track(UserInputService.InputBegan:Connect(function(input, gp)
    if not autoBFEnabled or gp then return end
    
    if input.KeyCode == Enum.KeyCode.Three or input.KeyCode == Enum.KeyCode.Alpha3 then
        task.spawn(function()
            task.wait(bfDelay) -- Chờ đúng khoảng thời gian tối ưu 0.35s sau khi ấn lần đầu[cite: 3]
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Three, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Three, false, game)
        end)
    end
end))

-- ================= PHÍM TẮT L & DỌN DẸP =================
track(UserInputService.InputBegan:Connect(function(input, gp)
    if not gp and input.KeyCode == TOGGLE_KEY then
        setVisible(not MainFrame.Visible)
    end
end))

local function cleanup()
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    table.clear(connections)
    MainGui:Destroy()
    FloatGui:Destroy()
    env.BLZHubCleanup = nil
end
env.BLZHubCleanup = cleanup
