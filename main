--[[
    JJS Auto Black Flash (Skill 3 - Yuji)
    - Tự động bấm phím 3 lần thứ hai sau 0.35 giây để ra Black Flash hoàn hảo.
]]

local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local CoreGui = game:GetService("CoreGui")

local enabled = false
local delayTime = 0.35 -- Thời gian chuẩn từ 0.3s đến 0.4s

-- Tạo nút bấm bật/tắt nhanh trên màn hình
local parentGui = (gethui and gethui()) or CoreGui
if parentGui:FindFirstChild("JJS_AutoBF") then parentGui.JJS_AutoBF:Destroy() end

local screenGui = Instance.new("ScreenGui", parentGui)
screenGui.Name = "JJS_AutoBF"

local btn = Instance.new("TextButton", screenGui)
btn.Size = UDim2.new(0, 160, 0, 40)
btn.Position = UDim2.new(0, 50, 0, 200)
btn.BackgroundColor3 = Color3.fromRGB(19, 19, 28)
btn.TextColor3 = Color3.fromRGB(0, 229, 255)
btn.Font = Enum.Font.GothamBold
btn.TextSize = 12
btn.Text = "Auto Black Flash: TẮT"
Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

local stroke = Instance.new("UIStroke", btn)
stroke.Color = Color3.fromRGB(0, 229, 255)
stroke.Thickness = 1.5

-- Bật/Tắt khi bấm vào nút
btn.MouseButton1Click:Connect(function()
    enabled = not enabled
    btn.Text = "Auto Black Flash: " .. (enabled and "BẬT" or "TẮT")
    stroke.Color = enabled and Color3.fromRGB(70, 220, 120) or Color3.fromRGB(0, 229, 255)
end)

-- Tự động nhịp phím 3 lần thứ hai
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not enabled or gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.Three or input.KeyCode == Enum.KeyCode.Alpha3 then
        task.spawn(function()
            task.wait(delayTime)
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Three, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Three, false, game)
        end)
    end
end)
